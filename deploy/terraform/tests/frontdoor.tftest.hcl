# Front Door: one uncached HTTPS route for every path to the app's own host
# name, and with a custom domain, a route of its own for its public paths.
# Every provider is mocked, so runs apply to synthetic state, never to Azure.

variables {
  subscription_id     = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  tenant_id           = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
  location            = "westus3"
  resource_group_name = "pghacker-example"
  name_prefix         = "pghacker-example"
  app_name            = "pghacker-example"
  acr_name            = "examplepghacr12345"
  key_vault_name      = "pghacker-example-kv"
  image               = "examplepghacr12345.azurecr.io/pghacker-mcp@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  deployer_object_ids = ["cccccccc-cccc-4ccc-8ccc-cccccccccccc"]
}

mock_provider "azurerm" {
  source = "./tests/mocks/azurerm"
}
mock_provider "azapi" {
  source = "./tests/mocks/azapi"
}
mock_provider "random" {
  source = "./tests/mocks/random"
}
mock_provider "time" {}

# The IDs that the mocked endpoint connections approve.
override_resource {
  target = azurerm_private_endpoint.horizondb
  values = { id = "/subscriptions/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa/resourceGroups/pghacker-example/providers/Microsoft.Network/privateEndpoints/pghacker-example-hdb-pe" }
}
override_resource {
  target = azurerm_private_endpoint.foundry
  values = { id = "/subscriptions/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa/resourceGroups/pghacker-example/providers/Microsoft.Network/privateEndpoints/pghacker-example-foundry-pe" }
}

# Before the app exists: the origin already points at its host name, so the
# OAuth callback URL is known before the GitHub OAuth App is registered.
run "front_door_before_the_app" {
  assert {
    condition = (
      length(azurerm_container_app.app) == 0
      && azurerm_cdn_frontdoor_origin.this.host_name == "pghacker-example.mock-1a2b3c4d.westus3.azurecontainerapps.io"
      && output.oauth_callback_url == "https://pghacker-example.mock.azurefd.net/oauth2/callback"
    )
    error_message = "Front Door, its origin and the callback URL must exist before the app."
  }

  assert {
    condition = (
      length(azurerm_cdn_frontdoor_custom_domain.this) == 0
      && try(length(azurerm_cdn_frontdoor_route.this.cdn_frontdoor_custom_domain_ids), 0) == 0
      && length(azurerm_cdn_frontdoor_route.public) == 0
      && output.front_door_custom_domain_validation == null
    )
    error_message = "Without a custom domain, no domain resource, route for it or ownership TXT record should be created."
  }
}

run "front_door_passes_everything_through" {
  variables {
    create_app = true
  }

  assert {
    condition = (
      azurerm_cdn_frontdoor_profile.this.name == "pghacker-example-afd"
      && azurerm_cdn_frontdoor_profile.this.sku_name == "Standard_AzureFrontDoor"
      && azurerm_cdn_frontdoor_profile.this.response_timeout_seconds == 240
    )
    error_message = "The profile must be Front Door Standard, waiting up to 240 s for the app."
  }

  assert {
    condition = (
      azapi_resource.front_door_endpoint.name == "pghacker"
      && azapi_resource.front_door_endpoint.parent_id == azurerm_cdn_frontdoor_profile.this.id
      && azapi_resource.front_door_endpoint.body.properties.autoGeneratedDomainNameLabelScope == "ResourceGroupReuse"
      && azapi_resource.front_door_endpoint.body.properties.enabledState == "Enabled"
    )
    error_message = "The endpoint's host name must be reusable only from this resource group."
  }

  assert {
    condition = (
      azurerm_cdn_frontdoor_route.this.patterns_to_match == tolist(["/*"])
      && azurerm_cdn_frontdoor_route.this.supported_protocols == toset(["Https"])
      && azurerm_cdn_frontdoor_route.this.forwarding_protocol == "HttpsOnly"
      && !azurerm_cdn_frontdoor_route.this.https_redirect_enabled
      && azurerm_cdn_frontdoor_route.this.link_to_default_domain
      && length(azurerm_cdn_frontdoor_route.this.cache) == 0
    )
    error_message = "The route must take every path over HTTPS only, to the app over HTTPS, without caching or compression."
  }

  assert {
    condition = (
      azurerm_cdn_frontdoor_route.this.cdn_frontdoor_endpoint_id == "/subscriptions/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa/resourceGroups/pghacker-example/providers/Microsoft.Cdn/profiles/pghacker-example-afd/afdEndpoints/pghacker"
      && azurerm_cdn_frontdoor_route.this.cdn_frontdoor_origin_group_id == azurerm_cdn_frontdoor_origin_group.this.id
      && azurerm_cdn_frontdoor_route.this.cdn_frontdoor_origin_ids == tolist([azurerm_cdn_frontdoor_origin.this.id])
    )
    error_message = "The route must join the endpoint to the app's origin."
  }

  assert {
    condition = (
      azurerm_cdn_frontdoor_origin.this.host_name == azurerm_container_app.app[0].ingress[0].fqdn
      && azurerm_cdn_frontdoor_origin.this.origin_host_header == azurerm_container_app.app[0].ingress[0].fqdn
      && azurerm_cdn_frontdoor_origin.this.certificate_name_check_enabled
      && azurerm_cdn_frontdoor_origin.this.https_port == 443
      && azurerm_cdn_frontdoor_origin.this.cdn_frontdoor_origin_group_id == azurerm_cdn_frontdoor_origin_group.this.id
    )
    error_message = "The origin must be the app's own host name, sent as the host header, with its certificate's name checked."
  }

  assert {
    condition     = length(azurerm_cdn_frontdoor_origin_group.this.health_probe) == 0 && !azurerm_cdn_frontdoor_origin_group.this.session_affinity_enabled
    error_message = "A single origin needs no health probes or session affinity."
  }

  assert {
    condition = (
      output.public_url == "https://pghacker-example.mock.azurefd.net"
      && output.portal_url == "https://pghacker-example.mock.azurefd.net/portal/"
      && output.mcp_url == "https://pghacker-example.mock.azurefd.net/mcp"
      && output.oauth_callback_url == "https://pghacker-example.mock.azurefd.net/oauth2/callback"
      && output.front_door_host_name == "pghacker-example.mock.azurefd.net"
      && output.front_door_id == azurerm_cdn_frontdoor_profile.this.resource_guid
    )
    error_message = "The outputs must give the home page, portal, MCP and OAuth callback URLs on Front Door's host name, and the profile's ID."
  }
}

run "custom_domain_serves_only_the_public_paths" {
  state_key = "custom"

  variables {
    create_app               = true
    front_door_custom_domain = "mcp.example.org"
  }

  assert {
    condition = (
      length(azurerm_cdn_frontdoor_custom_domain.this) == 1
      && azurerm_cdn_frontdoor_custom_domain.this[0].name == "mcp-example-org"
      && azurerm_cdn_frontdoor_custom_domain.this[0].host_name == "mcp.example.org"
      && azurerm_cdn_frontdoor_custom_domain.this[0].cdn_frontdoor_profile_id == azurerm_cdn_frontdoor_profile.this.id
      && azurerm_cdn_frontdoor_custom_domain.this[0].tls[0].certificate_type == "ManagedCertificate"
      && azurerm_cdn_frontdoor_custom_domain.this[0].tls[0].minimum_version == "TLS12"
    )
    error_message = "The optional hostname must create a managed TLS 1.2 custom domain in this profile."
  }

  assert {
    condition = (
      try(length(azurerm_cdn_frontdoor_route.this.cdn_frontdoor_custom_domain_ids), 0) == 0
      && azurerm_cdn_frontdoor_route.this.link_to_default_domain
      && azurerm_cdn_frontdoor_route.this.patterns_to_match == tolist(["/*"])
    )
    error_message = "Front Door's own host name alone must keep every path: the portal and its sign-in."
  }

  assert {
    condition = (
      length(azurerm_cdn_frontdoor_route.public) == 1
      && azurerm_cdn_frontdoor_route.public[0].cdn_frontdoor_custom_domain_ids == toset([azurerm_cdn_frontdoor_custom_domain.this[0].id])
      && !azurerm_cdn_frontdoor_route.public[0].link_to_default_domain
      && azurerm_cdn_frontdoor_route.public[0].patterns_to_match == tolist(["/", "/mcp", "/static/*", "/favicon.svg", "/robots.txt"])
      && azurerm_cdn_frontdoor_route.public[0].cdn_frontdoor_endpoint_id == azurerm_cdn_frontdoor_route.this.cdn_frontdoor_endpoint_id
      && azurerm_cdn_frontdoor_route.public[0].cdn_frontdoor_origin_group_id == azurerm_cdn_frontdoor_origin_group.this.id
      && azurerm_cdn_frontdoor_route.public[0].cdn_frontdoor_origin_ids == tolist([azurerm_cdn_frontdoor_origin.this.id])
      && azurerm_cdn_frontdoor_route.public[0].supported_protocols == toset(["Https"])
      && azurerm_cdn_frontdoor_route.public[0].forwarding_protocol == "HttpsOnly"
      && !azurerm_cdn_frontdoor_route.public[0].https_redirect_enabled
      && length(azurerm_cdn_frontdoor_route.public[0].cache) == 0
      && azurerm_cdn_frontdoor_origin.this.origin_host_header == output.app_fqdn
    )
    error_message = "The custom domain must have a route of its own to the app, uncached and HTTPS only, for the home page, its files, /mcp and /robots.txt alone."
  }

  assert {
    condition = (
      output.public_url == "https://mcp.example.org"
      && output.mcp_url == "https://mcp.example.org/mcp"
      && output.portal_url == "https://pghacker-example.mock.azurefd.net/portal/"
      && output.oauth_callback_url == "https://pghacker-example.mock.azurefd.net/oauth2/callback"
      && output.front_door_host_name == "pghacker-example.mock.azurefd.net"
      && output.front_door_custom_domain_validation == {
        name       = "_dnsauth.mcp.example.org"
        value      = "mock-domain-validation-token"
        expiration = "2026-12-01T00:00:00Z"
      }
    )
    error_message = "The home page and MCP URLs must move to the custom domain, the portal and OAuth callback stay on Front Door's host name, and the ownership TXT record be exported."
  }

  assert {
    condition = (
      one([for env in azurerm_container_app.app[0].template[0].container[0].env : env.value if env.name == "PGHACKER_PUBLIC_URL"]) == output.public_url
      && one([for env in azurerm_container_app.app[0].template[0].container[0].env : env.value if env.name == "PGHACKER_PORTAL_URL"]) == "https://pghacker-example.mock.azurefd.net"
      && one([for env in azurerm_container_app.app[0].template[0].container[0].env : env.value if env.name == "PGHACKER_PUBLIC_HOSTS"]) == "mcp.example.org,pghacker-example.mock.azurefd.net,pghacker-example.mock-1a2b3c4d.westus3.azurecontainerapps.io"
    )
    error_message = "The app must use the custom canonical URL, sign users in on Front Door's host name, and accept the custom, default and origin hostnames."
  }
}

run "custom_domain_replans" {
  command   = plan
  state_key = "custom"

  variables {
    create_app               = true
    front_door_custom_domain = "mcp.example.org"
  }

  assert {
    condition = (
      output.public_url == "https://mcp.example.org"
      && azurerm_cdn_frontdoor_route.this.link_to_default_domain
      && length(azurerm_cdn_frontdoor_route.public) == 1
    )
    error_message = "Replanning must preserve the custom canonical URL and both routes."
  }
}

run "removing_custom_domain_restores_defaults" {
  command   = plan
  state_key = "custom"

  variables {
    create_app               = true
    front_door_custom_domain = null
  }

  assert {
    condition = (
      length(azurerm_cdn_frontdoor_custom_domain.this) == 0
      && length(azurerm_cdn_frontdoor_route.public) == 0
      && try(length(azurerm_cdn_frontdoor_route.this.cdn_frontdoor_custom_domain_ids), 0) == 0
      && output.front_door_custom_domain_validation == null
      && output.public_url == "https://pghacker-example.mock.azurefd.net"
      && output.portal_url == "https://pghacker-example.mock.azurefd.net/portal/"
      && one([for env in azurerm_container_app.app[0].template[0].container[0].env : env.value if env.name == "PGHACKER_PUBLIC_HOSTS"]) == "pghacker-example.mock.azurefd.net,pghacker-example.mock-1a2b3c4d.westus3.azurecontainerapps.io"
    )
    error_message = "Removing the optional domain must remove its route and restore the default URLs and hostname allowlist."
  }
}

run "apex_custom_domain" {
  state_key = "apex"

  variables {
    front_door_custom_domain = "example.org"
  }

  override_resource {
    target = azurerm_cdn_frontdoor_custom_domain.this[0]
    values = { id = "/subscriptions/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa/resourceGroups/pghacker-example/providers/Microsoft.Cdn/profiles/pghacker-example-afd/customDomains/example-org" }
  }

  assert {
    condition = (
      azurerm_cdn_frontdoor_custom_domain.this[0].name == "example-org"
      && output.public_url == "https://example.org"
      && output.front_door_custom_domain_validation.name == "_dnsauth.example.org"
    )
    error_message = "Apex domains must work too, with the ownership TXT record under _dnsauth at the zone root."
  }
}

run "managed_certificate_accepts_64_characters" {
  command = plan

  variables {
    front_door_custom_domain = "${join("", [for i in range(60) : "a"])}.org"
  }
}

run "managed_certificate_rejects_65_characters" {
  command = plan

  variables {
    front_door_custom_domain = "${join("", [for i in range(61) : "a"])}.org"
  }

  expect_failures = [var.front_door_custom_domain]
}

