{
  "name": "pghacker-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pghacker-mcp: cited answers about PostgreSQL's design history and code, as a PilotSwarm app.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test": "node --test test/*.test.mjs home/src/*.test.ts",
    "test:routes": "node --test test/oauth2-proxy.integration.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "crawl": "node scripts/crawl.mjs",
    "eval": "node scripts/eval.mjs",
    "corpus:dump": "node scripts/corpus-dump.mjs",
    "rust:check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "pilotswarm": "file:dist-tarballs/pilotswarm-0.8.2.tgz",
    "pilotswarm-horizon-store": "file:dist-tarballs/pilotswarm-horizon-store-0.8.2.tgz",
    "pilotswarm-sdk": "file:dist-tarballs/pilotswarm-sdk-0.8.2.tgz"
  }
}
