# npm run setup generates .env with a random password. Do not use this placeholder.
POSTGRES_USER=pghacker
POSTGRES_DB=pghacker_mcp
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_PORT=55433
DATABASE_URL=postgresql://pghacker:replace-with-a-generated-local-password@127.0.0.1:55433/pghacker_mcp

PORTAL_PORT=3001
PORTAL_HOST=127.0.0.1
PORTAL_AUTH_PROVIDER=none
PORTAL_AUTHZ_DEFAULT_ROLE=admin
PORTAL_AUTH_ALLOW_UNAUTHENTICATED=true
# The app owns one SDK worker; the portal must not create additional workers.
WORKERS=0
# Session turns the worker runs at once (default 8, for crawls).
# PILOTSWARM_WORKER_CONCURRENCY=8
PORTAL_TUI_MODE=local

# Optional bootstrap credential. Prefer the shell environment or the portal's
# Admin Console -> Model Providers. Never put a real token in this example.
# GITHUB_TOKEN=

# pghacker roles (npm run setup generates both): pgh_indexer writes schema
# pghacker and the graph; pgh_reader serves the public pghacker-mcp server.
PGH_INDEXER_PASSWORD=replace-with-a-generated-local-password
PGH_READER_PASSWORD=replace-with-a-generated-local-password
# PGHACKER_INDEXER_PORT=3101
# PGHACKER_MCP_PORT=3102
# pghacker-mcp's rate limit per client address; local agents share 127.0.0.1.
# PGHACKER_RATE_PER_MINUTE=3000
# PGHACKER_RATE_BURST=500

# Embeddings for semantic and hybrid search, configured as PilotSwarm's
# HORIZON_EMBED_*: an Azure OpenAI text-embedding-3-small deployment, say.
# HORIZON_EMBED_URL=https://<resource>.openai.azure.com/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-10-21
# HORIZON_EMBED_MODEL=text-embedding-3-small
# HORIZON_EMBED_DIM=1536
# HORIZON_EMBED_API_KEY=
